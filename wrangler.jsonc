{
  "name": "vulture",
  "main": "src/order-api.mjs",
  "compatibility_date": "2026-01-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "vars": { "ORDERS_ENABLED": "true", "ACCOUNTS_ENABLED": "true", "TURNSTILE_SITE_KEY": "0x4AAAAAAGCi4SXccSLHNx4W" },
  "kv_namespaces": [{ "binding": "PHOTOS", "id": "a2c03b42acb04b8ba1204b721f2654e3" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ORDER_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "STAFF_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "TICKET_LIMITER", "namespace_id": "1004", "simple": { "limit": 20, "period": 60 } }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "vulture-orders",
    "database_id": "89e97c90-35d7-48d9-b3a6-da044afdc9f3",
    "migrations_dir": "migrations"
  }]
}
